{
  "expo": {
    "name": "NextSu AI",
    "slug": "fpt-telecom-portal",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fpttelecom.fptportal",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần quyền truy cập Camera để chụp ảnh minh chứng công việc (ví dụ: Bypass MyBAE).",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần quyền truy cập Thư viện ảnh để đính kèm hình ảnh báo cáo công việc."
      }
    },
    "android": {
      "package": "com.fpttelecom.fptportal",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "name": "NextSu AI",
      "shortName": "NextSu AI",
      "lang": "vi",
      "themeColor": "#0B1736",
      "backgroundColor": "#F8FAFC",
      "display": "standalone",
      "orientation": "portrait"
    },
    "extra": {
      "eas": {
        "projectId": "1ae2094a-2715-4df1-8a8f-c9c8d068f04a"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
